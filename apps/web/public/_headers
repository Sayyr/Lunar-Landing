# Cloudflare Pages headers for a static deploy of apps/web/dist
# (https://developers.cloudflare.com/pages/configuration/headers/). Ported from apps/moon-explorer/_headers.
/
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/data/*.tif
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/tiff
/data/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/data/*.png
  Cache-Control: public, max-age=31536000, immutable
/data/ldem_16/*.f32
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream
/data/ldem_16/manifest.json
  Cache-Control: public, max-age=86400
/data/features.json
  Cache-Control: public, max-age=86400
