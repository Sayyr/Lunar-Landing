{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selene.local/contracts/radio-link-response.schema.json",
  "title": "RadioLinkResponse",
  "description": "Direct-to-Earth radio-link windows (ENGINEERING tier). A link window means: Earth's centre above the lunar-side mask (ideal geometric horizon, no terrain) AND at least one requested station sees the Moon above its mask AND the free-space link budget closes with the request's hardware figures. It is a necessary condition, never a guaranteed link. The ephemeris is analytic and low precision (see `model` and `assumptions`).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "message", "request", "model", "data_provenance", "assumptions", "warnings", "summary", "samples", "windows"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "status": { "type": "string", "enum": ["computed"] },
    "message": { "type": "string" },
    "request": { "$ref": "radio-link-request.schema.json" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "ephemeris_provider", "horizon_model", "body_fixed_frame", "time_scale_note"],
      "properties": {
        "tier": { "type": "string", "enum": ["engineering"] },
        "ephemeris_provider": { "type": "string", "enum": ["analytic_meeus_truncated"], "description": "Analytic truncated series, NOT SPICE." },
        "horizon_model": { "type": "string", "enum": ["ideal_geometric"] },
        "body_fixed_frame": { "type": "string" },
        "time_scale_note": { "type": "string" }
      }
    },
    "data_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "source", "version", "license", "notes"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["spice_kernel", "dem", "synthetic", "other"] },
          "source": { "type": "string" },
          "version": { "type": ["string", "null"] },
          "license": { "type": ["string", "null"] },
          "notes": { "type": "string" }
        }
      }
    },
    "assumptions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span_hours", "earth_visible_fraction", "ground_station_visible_fraction", "link_available_fraction", "longest_link_outage_hours", "link_margin_db_min", "link_margin_db_max", "max_abs_doppler_hz"],
      "properties": {
        "span_hours": { "type": "number", "minimum": 0, "description": "First to last sample." },
        "earth_visible_fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "Fraction of the span; null for a single-sample grid." },
        "ground_station_visible_fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "link_available_fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "longest_link_outage_hours": { "type": "number", "minimum": 0 },
        "link_margin_db_min": { "type": "number", "description": "Over all samples, whatever the geometry." },
        "link_margin_db_max": { "type": "number" },
        "max_abs_doppler_hz": { "type": "number", "minimum": 0 }
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["utc", "earth", "earth_visible", "station", "station_elevation_deg", "station_visible", "range_m", "range_rate_m_s", "doppler_hz", "fspl_db", "cn0_dbhz", "ebn0_db", "margin_db", "link_available"],
        "properties": {
          "utc": { "type": "string" },
          "earth": {
            "type": "object",
            "additionalProperties": false,
            "required": ["azimuth_deg", "elevation_deg"],
            "properties": {
              "azimuth_deg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
              "elevation_deg": { "type": "number", "minimum": -90, "maximum": 90 }
            },
            "description": "Earth's centre from the lunar site: azimuth from local north toward east, elevation over the ideal geometric horizon."
          },
          "earth_visible": { "type": "boolean" },
          "station": { "type": "string", "description": "Serving station: largest elevation above its own mask (even when below it)." },
          "station_elevation_deg": { "type": "number", "minimum": -90, "maximum": 90, "description": "Moon's centre from the serving station." },
          "station_visible": { "type": "boolean" },
          "range_m": { "type": "number", "exclusiveMinimum": 0, "description": "Serving station to lunar site." },
          "range_rate_m_s": { "type": "number", "description": "Positive when the range increases." },
          "doppler_hz": { "type": "number", "description": "One-way shift of the received carrier (negative when receding)." },
          "fspl_db": { "type": "number" },
          "cn0_dbhz": { "type": "number" },
          "ebn0_db": { "type": "number" },
          "margin_db": { "type": "number", "description": "Eb/N0 minus required Eb/N0; > 0 means the budget closes." },
          "link_available": { "type": "boolean", "description": "earth_visible AND station_visible AND margin_db > 0." }
        }
      }
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["earth_visible", "ground_station_visible", "link_available", "stations"],
      "properties": {
        "earth_visible": { "type": "array", "items": { "$ref": "#/$defs/window" } },
        "ground_station_visible": { "type": "array", "items": { "$ref": "#/$defs/window" }, "description": "Union over the requested stations." },
        "link_available": { "type": "array", "items": { "$ref": "#/$defs/window" } },
        "stations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "windows"],
            "properties": {
              "name": { "type": "string" },
              "windows": { "type": "array", "items": { "$ref": "#/$defs/window" } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_utc", "end_utc", "clipped_start", "clipped_end"],
      "properties": {
        "start_utc": { "type": "string" },
        "end_utc": { "type": "string" },
        "clipped_start": { "type": "boolean", "description": "Window was already open at the first sample." },
        "clipped_end": { "type": "boolean", "description": "Window was still open at the last sample." }
      }
    }
  }
}
