{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selene.local/contracts/celestial-state-response.schema.json",
  "title": "CelestialStateResponse",
  "description": "Sun/Earth/Moon GEOMETRIC state at one instant, for visualisation (dashboard, globe lighting, sky compass). Positions carry no light-time or aberration correction; the apparent topocentric directions of a lunar site come from the scenario evaluation. When ephemerides are unavailable the services answer 503 with the error envelope: this response never carries invented positions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "synthetic",
    "utc",
    "frame",
    "moon_from_earth",
    "moon_from_sun",
    "sun_from_earth",
    "derived",
    "earth_orientation",
    "moon_orientation",
    "model",
    "assumptions",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "computed"
      ]
    },
    "synthetic": {
      "const": false
    },
    "utc": {
      "type": "string"
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "moon_from_earth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "longitude_deg",
        "latitude_deg",
        "distance_m",
        "position_m",
        "right_ascension_deg",
        "declination_deg"
      ],
      "properties": {
        "longitude_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360,
          "description": "Longitude in the response frame."
        },
        "latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "distance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "position_m": {
          "$ref": "#/$defs/vec3",
          "description": "Cartesian position in the response frame, metres."
        },
        "right_ascension_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360,
          "description": "J2000 (ICRF axes)."
        },
        "declination_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      }
    },
    "moon_from_sun": {
      "$ref": "#/$defs/relative"
    },
    "sun_from_earth": {
      "$ref": "#/$defs/relative"
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elongation_deg",
        "phase_angle_deg",
        "illuminated_fraction",
        "waxing",
        "phase_name"
      ],
      "properties": {
        "elongation_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 180,
          "description": "Angle Sun-Earth-Moon."
        },
        "phase_angle_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 180,
          "description": "Angle Sun-Moon-Earth."
        },
        "illuminated_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "waxing": {
          "type": "boolean"
        },
        "phase_name": {
          "type": "string"
        }
      }
    },
    "earth_orientation": {
      "$ref": "#/$defs/mat3",
      "description": "Row-major rotation Earth body-fixed (IAU_EARTH) -> response frame. Visualisation only."
    },
    "moon_orientation": {
      "$ref": "#/$defs/mat3",
      "description": "Row-major rotation Moon body-fixed (MOON_ME, lon 0 = mean sub-Earth meridian) -> response frame."
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "time_scale_note",
        "nominal_accuracy",
        "kernel_set"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "spice"
          ]
        },
        "time_scale_note": {
          "type": "string"
        },
        "nominal_accuracy": {
          "type": "string"
        },
        "kernel_set": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "mat3": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "number",
        "minimum": -1.0000001,
        "maximum": 1.0000001
      }
    },
    "relative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "longitude_deg",
        "latitude_deg",
        "distance_m",
        "position_m"
      ],
      "properties": {
        "longitude_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360,
          "description": "Longitude in the response frame."
        },
        "latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "distance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "position_m": {
          "$ref": "#/$defs/vec3",
          "description": "Cartesian position in the response frame, metres."
        }
      }
    }
  }
}
