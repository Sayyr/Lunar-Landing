# Copy to .env (never commit .env). All values are optional; defaults shown.

# --- services/science ---
# Directory containing SPICE kernels / meta-kernel (see data/README.md). Unset = ephemerides not ready.
SELENE_KERNEL_DIR=
# Raw LOLA polar DEM (PDS float32 .IMG) for POST /terrain/slope/check, e.g.
#   apps/web/data-raw/lola_polar/ldem_85s_20m_float.img   (see data/README.md; ~920 MB, not in Git)
# The label is found next to it (same stem, .lbl/.LBL) unless SELENE_DEM_LABEL is set. SHA256SUMS next
# to the image is read for provenance. Unset/unusable = the endpoint answers status "dem_unavailable".
SELENE_DEM_PATH=
SELENE_DEM_LABEL=
# Port for the science service (compose / local scripts)
SELENE_SCIENCE_PORT=8000

# --- services/api ---
# Listen address (default 0.0.0.0:8080)
SELENE_API_BIND=127.0.0.1:8080
SELENE_SCIENCE_URL=http://127.0.0.1:8000
SELENE_SCIENCE_TIMEOUT_S=30
PROFILES_FILE=/etc/lunar-landing/profiles.json
SCRIPTS_DIR=/usr/local/lib/lunar-landing
RUST_LOG=info

# --- apps/web (dev server) ---
# Where the Vite dev proxy forwards /api/*
SELENE_API_URL=http://127.0.0.1:8080
# Base URL of the LOLA elevation rasters (ldem_4.tif / ldem_16.tif). Default: <site>/data/.
# Point it at R2/a CDN (CORS required) if ldem_16 (63 MiB) exceeds the host's file-size limit.
# Vite reads VITE_* variables at dev/build time from apps/web/.env or the shell environment,
# NOT from this repo-root .env.
VITE_LUNAR_DEM_BASE=
